# Mẫu cấu hình. Chạy .\scripts\setup.ps1 để tạo file .env kèm mật khẩu ngẫu nhiên,
# hoặc copy file này thành .env rồi tự điền mật khẩu. KHÔNG commit file .env.

# --- PostgreSQL (Docker) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexus_devicecloud
POSTGRES_USER=nexus
POSTGRES_PASSWORD=

# --- Backend ---
# CORS: các origin được phép gọi API từ trình duyệt (phân tách bằng dấu phẩy)
NEXUS_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Cookie Secure: đặt true khi chạy sau HTTPS
NEXUS_COOKIE_SECURE=false
# Tài liệu OpenAPI/Swagger (đặt false ở môi trường production)
NEXUS_OPENAPI_ENABLED=true

# --- Dữ liệu demo (chỉ dùng cho máy phát triển) ---
NEXUS_SEED_ENABLED=true
NEXUS_SEED_ADMIN_EMAIL=admin@demo.local
# Tối thiểu 12 ký tự. Để trống thì backend sẽ từ chối khởi động khi seed đang bật.
NEXUS_SEED_ADMIN_PASSWORD=
