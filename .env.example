# Để trống: frontend gọi /api cùng origin và Vite proxy chuyển sang backend (khuyến nghị khi phát triển).
# Nếu muốn gọi thẳng backend, đặt ví dụ VITE_API_BASE_URL=http://localhost:8080
# (khi đó backend phải cho phép origin của frontend qua NEXUS_CORS_ALLOWED_ORIGINS).
VITE_API_BASE_URL=

# Địa chỉ backend mà Vite proxy dùng trong lúc dev.
VITE_API_PROXY_TARGET=http://localhost:8080
